{
  "expo": {
    "name": "SkillBridge Campus",
    "slug": "skillbridge-campus",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "skillbridge",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e1b4b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillbridge.campus",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SkillBridge requires access to your camera to upload profile and post photos.",
        "NSPhotoLibraryUsageDescription": "SkillBridge requires access to your photo library to select avatar and coursework documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e1b4b"
      },
      "package": "com.skillbridge.campus",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-updates",
        {
          "username": "skillbridge"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      },
      "apiUrl": "http://10.0.2.2:5000/api/v1",
      "productionApiUrl": "https://skillbridge-api.onrender.com/api/v1"
    }
  }
}
